# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# macOS
.DS_Store

# Editores
.vscode/
.idea/

# Modelos e artefatos grandes
models/base/*
models/adapters/*
models/published/*
!models/base/.gitkeep
!models/adapters/.gitkeep
!models/published/.gitkeep

# Datasets privados
datasets/versions/*
!datasets/versions/.gitkeep

# Artefatos pesados de experimentos; manifestos, resultados e relatórios são versionados
experiments/exp_*/artifacts/
experiments/exp_*/logs/
reports/*
!reports/.gitkeep

# Logs
*.log
logs/

# Segredos
*.key
*.pem
secrets/
